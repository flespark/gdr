# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Environments
.env
.venv
env/
venv/

# Ruff
.ruff_cache/

# mypy
.mypy_cache/

# Local toolchain archives seeded into the Docker build context by
# ci/validate-podman.sh (GDR_CI_XPACK_DIR); never commit the ~300MB blobs
ci/gdr-xpack/*.tar.gz
tests/fixtures/**/*.elf
tests/fixtures/**/*.bin
tests/fixtures/**/*.map
tests/fixtures/**/Build/
tests/fixtures/**/rtthread.bin

# IDE
.cursor/
.idea/
.vscode/

# OS
.DS_Store

# Convenience
tmp/
ref/

# Local agent workspace: scratch files and runs (never committed)
.pi/

# Extension (vscode/): Node output and the generated GDR runtime copy
node_modules/
vscode/dist/
vscode/resources/gdr/
*.vsix
