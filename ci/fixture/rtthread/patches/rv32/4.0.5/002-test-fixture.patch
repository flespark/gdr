diff --git a/bsp/gdr-rv32/main.c b/bsp/gdr-rv32/main.c
new file mode 100644
--- /dev/null
+++ b/bsp/gdr-rv32/main.c
@@ -0,0 +1,236 @@
+#include <rtthread.h>
+
+#define THREAD_STACK_SIZE 2048
+#define MAILBOX_SIZE 4
+#define MESSAGE_SIZE 8
+#define MQ_POOL_WORDS 32
+#define MEMPOOL_WORDS 64
+#define MEMPOOL_BLOCK_SIZE 32
+
+static struct rt_semaphore test_sem, wait_sem;
+static struct rt_mutex test_mutex, wait_mutex;
+static struct rt_event test_event, wait_event;
+static struct rt_mailbox test_mailbox, wait_mb_recv, wait_mb_send;
+static struct rt_messagequeue test_msgqueue, wait_mq_recv, wait_mq_send;
+static struct rt_mempool test_mempool, wait_mp;
+static struct rt_timer test_timer;
+static rt_ubase_t test_mailbox_pool[MAILBOX_SIZE];
+static rt_ubase_t wait_mb_recv_pool[MAILBOX_SIZE];
+static rt_ubase_t wait_mb_send_pool[MAILBOX_SIZE];
+static rt_ubase_t test_msgqueue_pool[MQ_POOL_WORDS];
+static rt_ubase_t wait_mq_recv_pool[MQ_POOL_WORDS];
+static rt_ubase_t wait_mq_send_pool[MQ_POOL_WORDS];
+static rt_ubase_t test_mempool_pool[MEMPOOL_WORDS];
+static rt_ubase_t wait_mp_pool[MEMPOOL_WORDS];
+static rt_uint8_t test_message[MESSAGE_SIZE] = {0, 1, 2, 3, 4, 5, 6, 7};
+static void *test_mempool_block;
+static void *wait_mp_block[64];
+
+#define DECLARE_THREAD(name) \
+    static struct rt_thread name##_thread; \
+    ALIGN(16) static rt_uint8_t name##_stack[THREAD_STACK_SIZE]
+
+DECLARE_THREAD(locker);
+DECLARE_THREAD(worker1);
+DECLARE_THREAD(worker2);
+DECLARE_THREAD(worker3);
+DECLARE_THREAD(worker4);
+DECLARE_THREAD(worker5);
+DECLARE_THREAD(worker6);
+DECLARE_THREAD(worker7);
+DECLARE_THREAD(worker8);
+DECLARE_THREAD(worker9);
+DECLARE_THREAD(worker10);
+DECLARE_THREAD(worker11);
+DECLARE_THREAD(gdr_unstarted);
+
+static void test_timer_timeout(void *parameter)
+{
+    (void)parameter;
+}
+
+static void locker_entry(void *parameter)
+{
+    (void)parameter;
+    rt_mutex_take(&wait_mutex, RT_WAITING_FOREVER);
+    while (1) rt_thread_mdelay(200);
+}
+
+static void worker1_entry(void *parameter)
+{
+    (void)parameter;
+    rt_mutex_take(&test_mutex, RT_WAITING_FOREVER);
+    while (1) rt_thread_mdelay(100);
+}
+
+static void worker2_entry(void *parameter)
+{
+    (void)parameter;
+    while (1)
+    {
+        rt_sem_take(&test_sem, RT_WAITING_FOREVER);
+        rt_thread_mdelay(50);
+    }
+}
+
+static volatile rt_uint32_t gdr_irq_hold;
+
+static __attribute__((noinline)) void gdr_bt_live_leaf(void)
+{
+    __asm volatile(".global gdr_bt_live_stop\ngdr_bt_live_stop:\nnop" ::: "memory");
+    while (gdr_irq_hold != 0U)
+    {
+        __asm volatile("nop" ::: "memory");
+    }
+}
+
+static __attribute__((noinline)) void gdr_bt_live_middle(void)
+{
+    gdr_bt_live_leaf();
+    __asm volatile("" ::: "memory");
+}
+
+static void worker3_entry(void *parameter)
+{
+    (void)parameter;
+    while (1)
+    {
+        gdr_bt_live_middle();
+        rt_thread_mdelay(200);
+    }
+}
+
+static void worker4_entry(void *parameter)
+{
+    (void)parameter;
+    rt_sem_take(&wait_sem, RT_WAITING_FOREVER);
+    while (1) rt_thread_mdelay(100);
+}
+
+static void worker5_entry(void *parameter)
+{
+    (void)parameter;
+    rt_mutex_take(&wait_mutex, RT_WAITING_FOREVER);
+    while (1) rt_thread_mdelay(100);
+}
+
+static void worker6_entry(void *parameter)
+{
+    rt_uint32_t received;
+    (void)parameter;
+    rt_event_recv(&wait_event, 0x40, RT_EVENT_FLAG_AND | RT_EVENT_FLAG_CLEAR,
+                  RT_WAITING_FOREVER, &received);
+    while (1) rt_thread_mdelay(100);
+}
+
+static void worker7_entry(void *parameter)
+{
+    rt_ubase_t value;
+    (void)parameter;
+    rt_mb_recv(&wait_mb_recv, &value, RT_WAITING_FOREVER);
+    while (1) rt_thread_mdelay(100);
+}
+
+static void worker8_entry(void *parameter)
+{
+    (void)parameter;
+    rt_mb_send_wait(&wait_mb_send, 0x9999, RT_WAITING_FOREVER);
+    while (1) rt_thread_mdelay(100);
+}
+
+static void worker9_entry(void *parameter)
+{
+    char buffer[MESSAGE_SIZE];
+    (void)parameter;
+    rt_mq_recv(&wait_mq_recv, buffer, sizeof(buffer), RT_WAITING_FOREVER);
+    while (1) rt_thread_mdelay(100);
+}
+
+static void worker10_entry(void *parameter)
+{
+    (void)parameter;
+    rt_mq_send_wait(&wait_mq_send, test_message, sizeof(test_message), RT_WAITING_FOREVER);
+    while (1) rt_thread_mdelay(100);
+}
+
+static void worker11_entry(void *parameter)
+{
+    (void)parameter;
+    rt_mp_alloc(&wait_mp, RT_WAITING_FOREVER);
+    while (1) rt_thread_mdelay(100);
+}
+
+static void gdr_unstarted_entry(void *parameter)
+{
+    (void)parameter;
+}
+
+#define INIT_THREAD(name, priority) \
+    RT_ASSERT(rt_thread_init(&name##_thread, #name, name##_entry, RT_NULL, \
+                            name##_stack, sizeof(name##_stack), priority, 10) == RT_EOK)
+#define START_THREAD(name) RT_ASSERT(rt_thread_startup(&name##_thread) == RT_EOK)
+
+int main(void)
+{
+    rt_size_t index;
+    rt_kprintf("GDR test fixture starting...\n");
+    RT_ASSERT(rt_sem_init(&test_sem, "test_sem", 1, RT_IPC_FLAG_FIFO) == RT_EOK);
+    RT_ASSERT(rt_sem_init(&wait_sem, "wait_sem", 0, RT_IPC_FLAG_FIFO) == RT_EOK);
+    RT_ASSERT(rt_mutex_init(&test_mutex, "test_mutex", RT_IPC_FLAG_FIFO) == RT_EOK);
+    RT_ASSERT(rt_mutex_init(&wait_mutex, "wait_mutex", RT_IPC_FLAG_FIFO) == RT_EOK);
+    RT_ASSERT(rt_event_init(&test_event, "test_event", RT_IPC_FLAG_FIFO) == RT_EOK);
+    RT_ASSERT(rt_event_send(&test_event, 0x5) == RT_EOK);
+    RT_ASSERT(rt_event_init(&wait_event, "wait_event", RT_IPC_FLAG_FIFO) == RT_EOK);
+    RT_ASSERT(rt_mb_init(&test_mailbox, "test_mailbox", test_mailbox_pool, MAILBOX_SIZE, RT_IPC_FLAG_FIFO) == RT_EOK);
+    RT_ASSERT(rt_mb_send(&test_mailbox, 0x1234) == RT_EOK);
+    RT_ASSERT(rt_mb_init(&wait_mb_recv, "wait_mb_recv", wait_mb_recv_pool, MAILBOX_SIZE, RT_IPC_FLAG_FIFO) == RT_EOK);
+    RT_ASSERT(rt_mb_init(&wait_mb_send, "wait_mb_send", wait_mb_send_pool, MAILBOX_SIZE, RT_IPC_FLAG_FIFO) == RT_EOK);
+    for (index = 0; index < MAILBOX_SIZE; index++)
+        RT_ASSERT(rt_mb_send(&wait_mb_send, 0x1111 * (index + 1)) == RT_EOK);
+    RT_ASSERT(rt_mq_init(&test_msgqueue, "test_msgqueue", test_msgqueue_pool, MESSAGE_SIZE, sizeof(test_msgqueue_pool), RT_IPC_FLAG_FIFO) == RT_EOK);
+    RT_ASSERT(rt_mq_send(&test_msgqueue, test_message, MESSAGE_SIZE) == RT_EOK);
+    RT_ASSERT(rt_mq_init(&wait_mq_recv, "wait_mq_recv", wait_mq_recv_pool, MESSAGE_SIZE, sizeof(wait_mq_recv_pool), RT_IPC_FLAG_FIFO) == RT_EOK);
+    RT_ASSERT(rt_mq_init(&wait_mq_send, "wait_mq_send", wait_mq_send_pool, MESSAGE_SIZE, sizeof(wait_mq_send_pool), RT_IPC_FLAG_FIFO) == RT_EOK);
+    for (index = 0; index < wait_mq_send.max_msgs; index++)
+        RT_ASSERT(rt_mq_send(&wait_mq_send, test_message, MESSAGE_SIZE) == RT_EOK);
+    RT_ASSERT(rt_mp_init(&test_mempool, "test_mempool", test_mempool_pool, sizeof(test_mempool_pool), MEMPOOL_BLOCK_SIZE) == RT_EOK);
+    test_mempool_block = rt_mp_alloc(&test_mempool, RT_WAITING_NO);
+    RT_ASSERT(test_mempool_block != RT_NULL);
+    RT_ASSERT(rt_mp_init(&wait_mp, "wait_mp", wait_mp_pool, sizeof(wait_mp_pool), MEMPOOL_BLOCK_SIZE) == RT_EOK);
+    for (index = 0; index < sizeof(wait_mp_block) / sizeof(wait_mp_block[0]); index++)
+    {
+        wait_mp_block[index] = rt_mp_alloc(&wait_mp, RT_WAITING_NO);
+        if (wait_mp_block[index] == RT_NULL) break;
+    }
+    rt_timer_init(&test_timer, "test_timer", test_timer_timeout, RT_NULL,
+                  100, RT_TIMER_FLAG_PERIODIC | RT_TIMER_FLAG_SOFT_TIMER);
+    RT_ASSERT(rt_timer_start(&test_timer) == RT_EOK);
+    INIT_THREAD(locker, 20);
+    INIT_THREAD(worker1, 20);
+    INIT_THREAD(worker2, 21);
+    INIT_THREAD(worker3, 22);
+    INIT_THREAD(worker4, 23);
+    INIT_THREAD(worker5, 24);
+    INIT_THREAD(worker6, 25);
+    INIT_THREAD(worker7, 26);
+    INIT_THREAD(worker8, 27);
+    INIT_THREAD(worker9, 28);
+    INIT_THREAD(worker10, 29);
+    INIT_THREAD(worker11, 30);
+    INIT_THREAD(gdr_unstarted, 30);
+    START_THREAD(locker);
+    START_THREAD(worker1);
+    START_THREAD(worker2);
+    START_THREAD(worker3);
+    START_THREAD(worker4);
+    START_THREAD(worker5);
+    START_THREAD(worker6);
+    START_THREAD(worker7);
+    START_THREAD(worker8);
+    START_THREAD(worker9);
+    START_THREAD(worker10);
+    START_THREAD(worker11);
+    rt_thread_mdelay(20);
+    rt_kprintf("GDR test fixture ready.\n");
+    return 0;
+}
