# GDR upper-bound GDB compatibility image.
#
# Built on stable Debian trixie with the exact ARM Cortex-A9 fixture toolchain
# (xPack GCC, QEMU, SCons, uv) plus native GDB build dependencies. The distro
# `gdb-multiarch` package is intentionally omitted so monthly CI runs compile
# and verify the true latest stable upstream GNU GDB release into
# `/opt/gdb-latest/bin/gdb-multiarch`.
FROM debian:trixie-slim

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get -o Acquire::Retries=3 update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        bison \
        build-essential \
        ca-certificates \
        curl \
        flex \
        git \
        libexpat1-dev \
        libgmp-dev \
        libmpfr-dev \
        libncurses-dev \
        pkg-config \
        python3 \
        python3-dev \
        python3-venv \
        qemu-system-arm \
        tar \
        xz-utils \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/* \
    && curl -LsSf https://astral.sh/uv/0.5.11/install.sh | sh \
    && ln -sf /root/.local/bin/uv /usr/local/bin/uv \
    && python3 -m venv /opt/scons-venv \
    && /opt/scons-venv/bin/pip install --no-cache-dir "scons>=4.6,<5" \
    && ln -sf /opt/scons-venv/bin/scons /usr/local/bin/scons

# Keep the test fixture compiler identical to the regular Cortex-A9 and GDB 12
# lanes so GDB/Python is the only compatibility variable.
ARG XPACK_ARM_VERSION=15.2.1-1.1
ARG XPACK_ARM_SHA256=da6a49ad4003944b823c6c93702a8787c922ab34bd7e918ec0eaf6933a9b1ff6
RUN arm_archive="xpack-arm-none-eabi-gcc-${XPACK_ARM_VERSION}-linux-x64.tar.gz" \
    && curl --http1.1 --fail --location --retry 3 --retry-all-errors --retry-delay 3 --output "/tmp/$arm_archive" \
        "https://github.com/xpack-dev-tools/arm-none-eabi-gcc-xpack/releases/download/v${XPACK_ARM_VERSION}/$arm_archive" \
    && echo "${XPACK_ARM_SHA256}  /tmp/$arm_archive" | sha256sum --check - \
    && tar --extract --gzip --file "/tmp/$arm_archive" --directory /opt \
    && rm "/tmp/$arm_archive" \
    && /opt/xpack-arm-none-eabi-gcc-${XPACK_ARM_VERSION}/bin/arm-none-eabi-gcc --version | head -n 1 \
    && printf '#include <stdio.h>\n' | /opt/xpack-arm-none-eabi-gcc-${XPACK_ARM_VERSION}/bin/arm-none-eabi-gcc -E -x c - >/dev/null

ENV PATH=/opt/gdb-latest/bin:/opt/xpack-arm-none-eabi-gcc-15.2.1-1.1/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

WORKDIR /workspace
