# GDR minimum GDB compatibility image.
#
# Ubuntu 22.04 supplies GDB 12 linked with CPython 3.10. This intentionally
# builds only the Cortex-A9 fixture: the current Debian image owns the full
# RT-Thread x architecture matrix, while this image catches GDB API drift at
# the oldest supported interpreter baseline without duplicating that cost.
# It keeps the same pinned ARM toolchain as the normal A9 job, so GDB/Python
# is the only compatibility variable between the two lanes.
FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gdb-multiarch \
        git \
        python3 \
        python3-venv \
        qemu-system-arm \
        tar \
    && rm -rf /var/lib/apt/lists/* \
    && curl -LsSf https://astral.sh/uv/0.5.11/install.sh | sh \
    && ln -sf /root/.local/bin/uv /usr/local/bin/uv \
    && python3 -m venv /opt/scons-venv \
    && /opt/scons-venv/bin/pip install --no-cache-dir "scons>=4.6,<5"

# Keep the test fixture compiler identical to the regular Cortex-A9 matrix.
# Reason: a distribution compiler can alter the fixture's stack layout and
# confound a GDB/Python compatibility result.
ARG XPACK_ARM_VERSION=15.2.1-1.1
ARG XPACK_ARM_SHA256=da6a49ad4003944b823c6c93702a8787c922ab34bd7e918ec0eaf6933a9b1ff6
RUN arm_archive="xpack-arm-none-eabi-gcc-${XPACK_ARM_VERSION}-linux-x64.tar.gz" \
    && curl --fail --location --retry 3 --output "/tmp/$arm_archive" \
        "https://github.com/xpack-dev-tools/arm-none-eabi-gcc-xpack/releases/download/v${XPACK_ARM_VERSION}/$arm_archive" \
    && echo "${XPACK_ARM_SHA256}  /tmp/$arm_archive" | sha256sum --check - \
    && tar --extract --gzip --file "/tmp/$arm_archive" --directory /opt \
    && rm "/tmp/$arm_archive" \
    && /opt/xpack-arm-none-eabi-gcc-${XPACK_ARM_VERSION}/bin/arm-none-eabi-gcc --version | head -n 1 \
    && printf '#include <stdio.h>\n' | /opt/xpack-arm-none-eabi-gcc-${XPACK_ARM_VERSION}/bin/arm-none-eabi-gcc -E -x c - >/dev/null

# Verify the immutable purpose of this image while building it. Runtime jobs
# repeat the check via ci/check-gdb-python.sh before every actual GDB session.
RUN LC_ALL=C gdb-multiarch --version | head -n 1 | grep -Eq ' 12(\.| )' \
    && gdb-multiarch --nx --quiet --batch \
        --ex 'python import sys; assert sys.version_info[:2] == (3, 10), sys.version' \
    && /opt/xpack-arm-none-eabi-gcc-${XPACK_ARM_VERSION}/bin/arm-none-eabi-gcc --version | head -n 1

ENV XPACK_ARM_TOOLCHAIN_PATH=/opt/xpack-arm-none-eabi-gcc-15.2.1-1.1/bin \
    PATH=/opt/xpack-arm-none-eabi-gcc-15.2.1-1.1/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

WORKDIR /workspace
