+/*
+ * GDR test fixture: creates known kernel objects for QEMU smoke tests.
+ *
+ * When the system reaches the idle loop, the following objects exist:
+ * - Threads: "main" (finishes quickly), "locker" (holds wait_mutex),
+ *   "worker1".."worker3"
+ * - Semaphores: "test_sem" (value=1), "wait_sem" (empty, worker4 waits)
+ * - Mutexes: "test_mutex" (held by worker1), "wait_mutex" (held by locker,
+ *   worker5 waits)
+ * - Events: "test_event" (set=0x5), "wait_event" (worker6 waits on a mask)
+ * - Mailboxes: "test_mailbox" (one queued value), "wait_mb_recv" (empty,
+ *   worker7 waits), "wait_mb_send" (full, worker8 send-waits)
+ * - Message queues: "test_msgqueue" (one queued message), "wait_mq_recv"
+ *   (empty, worker9 waits). No sender waiter: this kernel version has no
+ *   rt_mq_send_wait, so SendWaiters renders N/A.
+ * - Memory pools: "test_mempool" (one allocated block), "wait_mp"
+ *   (exhausted; worker11 alloc-waits)
+ * - Timers: "test_timer" (periodic, 100 ticks)
+ *
+ * The GDB test suite stops at rt_thread_idle_excute and asserts these
+ * objects are visible via $gdr_thread(), rtthread threads, etc.
+ */
+
+#include <rtthread.h>
+
+#define THREAD_STACK_SIZE 1024
+#define THREAD_PRIORITY   20
+#define MAILBOX_SIZE      4
+#define MESSAGE_SIZE      8
+#define MQ_POOL_WORDS     32
+#define MEMPOOL_WORDS     64
+#define MEMPOOL_BLOCK_SIZE 32
+
+static struct rt_semaphore test_sem;
+static struct rt_semaphore wait_sem;
+static struct rt_mutex test_mutex;
+static struct rt_mutex wait_mutex;
+static struct rt_timer test_timer;
+static struct rt_event test_event;
+static struct rt_event wait_event;
+static struct rt_mailbox test_mailbox;
+static struct rt_mailbox wait_mb_recv;
+static struct rt_mailbox wait_mb_send;
+static struct rt_messagequeue test_msgqueue;
+static struct rt_messagequeue wait_mq_recv;
+static struct rt_mempool test_mempool;
+static struct rt_mempool wait_mp;
+
+static rt_ubase_t test_mailbox_pool[MAILBOX_SIZE];
+static rt_ubase_t wait_mb_recv_pool[MAILBOX_SIZE];
+static rt_ubase_t wait_mb_send_pool[MAILBOX_SIZE];
+static rt_ubase_t test_msgqueue_pool[MQ_POOL_WORDS];
+static rt_ubase_t wait_mq_recv_pool[MQ_POOL_WORDS];
+static rt_ubase_t test_mempool_pool[MEMPOOL_WORDS];
+static rt_ubase_t wait_mp_pool[MEMPOOL_WORDS];
+static rt_uint8_t test_message[MESSAGE_SIZE] = {0, 1, 2, 3, 4, 5, 6, 7};
+static void *test_mempool_block;
+static void *wait_mp_block[64];
+
+static rt_uint8_t locker_stack[THREAD_STACK_SIZE];
+static rt_uint8_t worker1_stack[THREAD_STACK_SIZE];
+static rt_uint8_t worker2_stack[THREAD_STACK_SIZE];
+static rt_uint8_t worker3_stack[THREAD_STACK_SIZE];
+static rt_uint8_t worker4_stack[THREAD_STACK_SIZE];
+static rt_uint8_t worker5_stack[THREAD_STACK_SIZE];
+static rt_uint8_t worker6_stack[THREAD_STACK_SIZE];
+static rt_uint8_t worker7_stack[THREAD_STACK_SIZE];
+static rt_uint8_t worker8_stack[THREAD_STACK_SIZE];
+static rt_uint8_t worker9_stack[THREAD_STACK_SIZE];
+static rt_uint8_t worker11_stack[THREAD_STACK_SIZE];
+
+static struct rt_thread locker_thread;
+static struct rt_thread worker1_thread;
+static struct rt_thread worker2_thread;
+static struct rt_thread worker3_thread;
+static struct rt_thread worker4_thread;
+static struct rt_thread worker5_thread;
+static struct rt_thread worker6_thread;
+static struct rt_thread worker7_thread;
+static struct rt_thread worker8_thread;
+static struct rt_thread worker9_thread;
+static struct rt_thread worker11_thread;
+
+static void test_timer_timeout(void *parameter)
+{
+    (void)parameter;
+}
+
+/* locker: holds wait_mutex forever so worker5 can wait on it. */
+static void locker_entry(void *parameter)
+{
+    (void)parameter;
+
+    rt_mutex_take(&wait_mutex, RT_WAITING_FOREVER);
+    while (1)
+    {
+        rt_thread_mdelay(200);
+    }
+}
+
+static void worker1_entry(void *parameter)
+{
+    (void)parameter;
+
+    rt_mutex_take(&test_mutex, RT_WAITING_FOREVER);
+    while (1)
+    {
+        rt_thread_mdelay(100);
+    }
+}
+
+static void worker2_entry(void *parameter)
+{
+    (void)parameter;
+
+    while (1)
+    {
+        rt_sem_take(&test_sem, RT_WAITING_FOREVER);
+        rt_thread_mdelay(50);
+    }
+}
+
+static void worker3_entry(void *parameter)
+{
+    (void)parameter;
+
+    while (1)
+    {
+        rt_thread_mdelay(200);
+    }
+}
+
+/* worker4: permanently waits on the empty wait_sem -> semaphore waiter. */
+static void worker4_entry(void *parameter)
+{
+    (void)parameter;
+
+    rt_sem_take(&wait_sem, RT_WAITING_FOREVER);
+    while (1)
+    {
+        rt_thread_mdelay(100);
+    }
+}
+
+/* worker5: permanently waits on the held wait_mutex -> mutex waiter. */
+static void worker5_entry(void *parameter)
+{
+    (void)parameter;
+
+    rt_mutex_take(&wait_mutex, RT_WAITING_FOREVER);
+    while (1)
+    {
+        rt_thread_mdelay(100);
+    }
+}
+
+/* worker6: waits on an unsatisfiable event mask -> event waiter. */
+static void worker6_entry(void *parameter)
+{
+    (void)parameter;
+
+    {
+        rt_uint32_t recved;
+        rt_event_recv(&wait_event, 0x40,
+                      RT_EVENT_FLAG_AND | RT_EVENT_FLAG_CLEAR, RT_WAITING_FOREVER,
+                      &recved);
+    }
+    while (1)
+    {
+        rt_thread_mdelay(100);
+    }
+}
+
+/* worker7: waits on the empty wait_mb_recv -> mailbox receiver. */
+static void worker7_entry(void *parameter)
+{
+    (void)parameter;
+
+    {
+        rt_ubase_t value;
+        rt_mb_recv(&wait_mb_recv, &value, RT_WAITING_FOREVER);
+    }
+    while (1)
+    {
+        rt_thread_mdelay(100);
+    }
+}
+
+/* worker8: send-waits on the full wait_mb_send -> mailbox sender. */
+static void worker8_entry(void *parameter)
+{
+    (void)parameter;
+
+    rt_mb_send_wait(&wait_mb_send, 0x9999, RT_WAITING_FOREVER);
+    while (1)
+    {
+        rt_thread_mdelay(100);
+    }
+}
+
+/* worker9: waits on the empty wait_mq_recv -> messagequeue receiver. */
+static void worker9_entry(void *parameter)
+{
+    (void)parameter;
+
+    {
+        char buffer[MESSAGE_SIZE];
+        rt_mq_recv(&wait_mq_recv, buffer, sizeof(buffer), RT_WAITING_FOREVER);
+    }
+    while (1)
+    {
+        rt_thread_mdelay(100);
+    }
+}
+
+
+/* worker11: alloc-waits on the exhausted wait_mp -> mempool waiter. */
+static void worker11_entry(void *parameter)
+{
+    (void)parameter;
+
+    rt_mp_alloc(&wait_mp, RT_WAITING_FOREVER);
+    while (1)
+    {
+        rt_thread_mdelay(100);
+    }
+}
 
 int main(void)
