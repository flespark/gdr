diff --git a/bsp/qemu-virt64-riscv/applications/main.c b/bsp/qemu-virt64-riscv/applications/main.c
index 50d2de7a229a3ef3c56b2a8e27cde06c9e4d8064..6b844cd711e62eb1e24ab0620799347c72cf85a2 100644
--- a/bsp/qemu-virt64-riscv/applications/main.c
+++ b/bsp/qemu-virt64-riscv/applications/main.c
@@ -9,13 +9,118 @@
  */
 
 #include <rtthread.h>
-#include <rthw.h>
-#include <stdio.h>
-#include <string.h>
+
+#define THREAD_STACK_SIZE 1024
+#define THREAD_PRIORITY   20
+#define MAILBOX_SIZE      4
+#define MESSAGE_SIZE      8
+#define MQ_POOL_WORDS     32
+#define MEMPOOL_WORDS     64
+#define MEMPOOL_BLOCK_SIZE 32
+
+static struct rt_semaphore test_sem;
+static struct rt_mutex test_mutex;
+static struct rt_timer test_timer;
+static struct rt_event test_event;
+static struct rt_mailbox test_mailbox;
+static struct rt_messagequeue test_msgqueue;
+static struct rt_mempool test_mempool;
+
+static rt_ubase_t test_mailbox_pool[MAILBOX_SIZE];
+static rt_ubase_t test_msgqueue_pool[MQ_POOL_WORDS];
+static rt_ubase_t test_mempool_pool[MEMPOOL_WORDS];
+static rt_uint8_t test_message[MESSAGE_SIZE] = {0, 1, 2, 3, 4, 5, 6, 7};
+static void *test_mempool_block;
+
+static rt_uint8_t worker1_stack[THREAD_STACK_SIZE];
+static rt_uint8_t worker2_stack[THREAD_STACK_SIZE];
+static rt_uint8_t worker3_stack[THREAD_STACK_SIZE];
+
+static struct rt_thread worker1_thread;
+static struct rt_thread worker2_thread;
+static struct rt_thread worker3_thread;
+
+static void test_timer_timeout(void *parameter)
+{
+    (void)parameter;
+}
+
+static void worker1_entry(void *parameter)
+{
+    (void)parameter;
+
+    rt_mutex_take(&test_mutex, RT_WAITING_FOREVER);
+    while (1)
+    {
+        rt_thread_mdelay(100);
+    }
+}
+
+static void worker2_entry(void *parameter)
+{
+    (void)parameter;
+
+    while (1)
+    {
+        rt_sem_take(&test_sem, RT_WAITING_FOREVER);
+        rt_thread_mdelay(50);
+    }
+}
+
+static void worker3_entry(void *parameter)
+{
+    (void)parameter;
+
+    while (1)
+    {
+        rt_thread_mdelay(200);
+    }
+}
 
 int main(void)
 {
-    printf("Hello RISC-V!\n");
+    rt_kprintf("GDR test fixture starting...\n");
+
+    rt_sem_init(&test_sem, "test_sem", 1, RT_IPC_FLAG_FIFO);
+    rt_mutex_init(&test_mutex, "test_mutex", RT_IPC_FLAG_FIFO);
+    RT_ASSERT(rt_event_init(&test_event, "test_event",
+                            RT_IPC_FLAG_FIFO) == RT_EOK);
+    RT_ASSERT(rt_event_send(&test_event, 0x5) == RT_EOK);
+
+    RT_ASSERT(rt_mb_init(&test_mailbox, "test_mailbox", test_mailbox_pool,
+                         MAILBOX_SIZE, RT_IPC_FLAG_FIFO) == RT_EOK);
+    RT_ASSERT(rt_mb_send(&test_mailbox, 0x1234) == RT_EOK);
+
+    RT_ASSERT(rt_mq_init(&test_msgqueue, "test_msgqueue", test_msgqueue_pool,
+                         sizeof(test_message), sizeof(test_msgqueue_pool),
+                         RT_IPC_FLAG_FIFO) == RT_EOK);
+    RT_ASSERT(rt_mq_send(&test_msgqueue, test_message,
+                         sizeof(test_message)) == RT_EOK);
+
+    RT_ASSERT(rt_mp_init(&test_mempool, "test_mempool", test_mempool_pool,
+                         sizeof(test_mempool_pool),
+                         MEMPOOL_BLOCK_SIZE) == RT_EOK);
+    test_mempool_block = rt_mp_alloc(&test_mempool, RT_WAITING_NO);
+    RT_ASSERT(test_mempool_block != RT_NULL);
+    rt_timer_init(&test_timer, "test_timer", test_timer_timeout, RT_NULL,
+                  100, RT_TIMER_FLAG_PERIODIC | RT_TIMER_FLAG_SOFT_TIMER);
+    rt_timer_start(&test_timer);
+
+    rt_thread_init(&worker1_thread, "worker1", worker1_entry, RT_NULL,
+                   worker1_stack, sizeof(worker1_stack),
+                   THREAD_PRIORITY, 10);
+    rt_thread_init(&worker2_thread, "worker2", worker2_entry, RT_NULL,
+                   worker2_stack, sizeof(worker2_stack),
+                   THREAD_PRIORITY + 1, 10);
+    rt_thread_init(&worker3_thread, "worker3", worker3_entry, RT_NULL,
+                   worker3_stack, sizeof(worker3_stack),
+                   THREAD_PRIORITY + 2, 10);
+
+    rt_thread_startup(&worker1_thread);
+    rt_thread_startup(&worker2_thread);
+    rt_thread_startup(&worker3_thread);
+
+    rt_kprintf("GDR test fixture ready.\n");
 
     return 0;
 }
