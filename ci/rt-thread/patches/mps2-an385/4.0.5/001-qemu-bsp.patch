+import os
+
+ARCH = "arm"
+CPU = "cortex-m3"
+CROSS_TOOL = "gcc"
+PLATFORM = "gcc"
+EXEC_PATH = os.environ.get("RTT_EXEC_PATH", "")
+PREFIX = "arm-none-eabi-"
+CC = PREFIX + "gcc"
+CXX = PREFIX + "g++"
+AS = PREFIX + "gcc"
+AR = PREFIX + "ar"
+LINK = PREFIX + "gcc"
+SIZE = PREFIX + "size"
+OBJDUMP = PREFIX + "objdump"
+OBJCPY = PREFIX + "objcopy"
+TARGET_EXT = "elf"
+DEVICE = " -mcpu=cortex-m3 -mthumb -mfloat-abi=soft"
+CFLAGS = DEVICE + " -O0 -g3 -gdwarf-4 -funwind-tables -fno-omit-frame-pointer"
+CFLAGS += " -ffunction-sections -fdata-sections -fno-common -fno-builtin -Wall"
+CXXFLAGS = CFLAGS
+AFLAGS = DEVICE + " -c -x assembler-with-cpp -g3 -gdwarf-4"
+LFLAGS = DEVICE + " -nostartfiles --specs=nosys.specs -Wl,--gc-sections,-Map=rtthread.map,-cref"
+LFLAGS += " -T linker.ld"
+CPATH = ""
+LPATH = ""
+POST_ACTION = OBJCPY + " -O binary $TARGET rtthread.bin\n" + SIZE + " $TARGET\n"
