--- /dev/null
+++ b/bsp/gdr-mps2-an385/SConstruct
@@ -0,0 +1,24 @@
+import os
+import sys
+
+import rtconfig
+
+RTT_ROOT = os.path.abspath(os.path.join(os.getcwd(), "../.."))
+sys.path.append(os.path.join(RTT_ROOT, "tools"))
+from building import *
+
+DefaultEnvironment(tools=[])
+env = Environment(
+    tools=["mingw"],
+    AS=rtconfig.AS, ASFLAGS=rtconfig.AFLAGS,
+    CC=rtconfig.CC, CCFLAGS=rtconfig.CFLAGS,
+    CXX=rtconfig.CXX, CXXFLAGS=rtconfig.CXXFLAGS,
+    AR=rtconfig.AR, ARFLAGS="-rc",
+    LINK=rtconfig.LINK, LINKFLAGS=rtconfig.LFLAGS,
+    LIBS=["gcc"],
+)
+env.PrependENVPath("PATH", rtconfig.EXEC_PATH)
+env["ASCOM"] = env["ASPPCOM"]
+Export("RTT_ROOT", "rtconfig")
+objects = PrepareBuilding(env, RTT_ROOT, has_libcpu=False)
+DoBuilding("rtthread." + rtconfig.TARGET_EXT, objects)
