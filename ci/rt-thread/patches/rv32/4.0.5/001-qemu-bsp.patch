diff --git a/bsp/gdr-rv32/board.c b/bsp/gdr-rv32/board.c
new file mode 100644
--- /dev/null
+++ b/bsp/gdr-rv32/board.c
@@ -0,0 +1,60 @@
+#include <rthw.h>
+#include <rtthread.h>
+
+#define REG32(address) (*(volatile rt_uint32_t *)(address))
+#define UART8(offset) (*(volatile rt_uint8_t *)(0x10000000u + (offset)))
+#define MTIME 0x0200bff8u
+#define MTIMECMP 0x02004000u
+
+extern rt_uint8_t __heap_start[], __heap_end[];
+volatile rt_uint32_t gdr_tick_interrupts;
+
+static void timer_arm(void)
+{
+    rt_uint32_t high, low, check;
+    rt_uint64_t next;
+    do
+    {
+        high = REG32(MTIME + 4);
+        low = REG32(MTIME);
+        check = REG32(MTIME + 4);
+    } while (high != check);
+    next = ((rt_uint64_t)high << 32 | low) + 10000000u / RT_TICK_PER_SECOND;
+    REG32(MTIMECMP) = 0xffffffffu;
+    REG32(MTIMECMP + 4) = next >> 32;
+    REG32(MTIMECMP) = (rt_uint32_t)next;
+}
+
+void rt_hw_console_output(const char *text)
+{
+    while (*text)
+    {
+        if (*text == '\n')
+        {
+            while (!(UART8(5) & 0x20)) {}
+            UART8(0) = '\r';
+        }
+        while (!(UART8(5) & 0x20)) {}
+        UART8(0) = *text++;
+    }
+}
+
+void rt_hw_board_init(void)
+{
+    rt_system_heap_init(__heap_start, __heap_end);
+    timer_arm();
+    __asm volatile("csrs mie, %0" :: "r"(0x80));
+}
+
+void handle_trap(rt_ubase_t cause, rt_ubase_t pc, void *stack)
+{
+    (void)stack;
+    if (cause != 0x80000007u)
+    {
+        rt_kprintf("unexpected trap: cause=%x pc=%x\n", cause, pc);
+        while (1) {}
+    }
+    timer_arm();
+    gdr_tick_interrupts++;
+    rt_tick_increase();
+}
diff --git a/bsp/gdr-rv32/startup.S b/bsp/gdr-rv32/startup.S
new file mode 100644
--- /dev/null
+++ b/bsp/gdr-rv32/startup.S
@@ -0,0 +1,34 @@
+    .section .text.startup, "ax", %progbits
+    .globl _start
+    .type _start, %function
+_start:
+    csrw mstatus, zero
+    csrw mie, zero
+    csrr a0, mhartid
+    bnez a0, 3f
+    .option push
+    .option norelax
+    la gp, __global_pointer$
+    .option pop
+    la sp, _sp
+    la t0, trap_entry
+    csrw mtvec, t0
+    la t0, _sbss
+    la t1, _ebss
+1:
+    bgeu t0, t1, 2f
+    sw zero, 0(t0)
+    addi t0, t0, 4
+    j 1b
+2:
+    call rtthread_startup
+3:
+    wfi
+    j 3b
+    .size _start, .-_start
+
+    .globl rt_hw_cpu_reset
+    .type rt_hw_cpu_reset, %function
+rt_hw_cpu_reset:
+    j rt_hw_cpu_reset
+    .size rt_hw_cpu_reset, .-rt_hw_cpu_reset
diff --git a/bsp/gdr-rv32/linker.ld b/bsp/gdr-rv32/linker.ld
new file mode 100644
--- /dev/null
+++ b/bsp/gdr-rv32/linker.ld
@@ -0,0 +1,43 @@
+OUTPUT_ARCH(riscv)
+ENTRY(_start)
+
+MEMORY
+{
+    RAM (rwx) : ORIGIN = 0x80000000, LENGTH = 16M
+}
+
+SECTIONS
+{
+    .text :
+    {
+        KEEP(*(.text.startup))
+        *(.text*)
+        *(.rodata*)
+    } > RAM
+    .eh_frame : { KEEP(*(.eh_frame)) } > RAM
+    .data : ALIGN(16)
+    {
+        *(.data*)
+        PROVIDE(__global_pointer$ = . + 0x800);
+        *(.sdata*)
+    } > RAM
+    .bss (NOLOAD) : ALIGN(16)
+    {
+        _sbss = .;
+        *(.bss*) *(.sbss*) *(COMMON)
+        . = ALIGN(16);
+        _ebss = .;
+    } > RAM
+    .heap (NOLOAD) : ALIGN(16)
+    {
+        __heap_start = .;
+        . += 64K;
+        __heap_end = .;
+    } > RAM
+    .irq_stack (NOLOAD) : ALIGN(16)
+    {
+        __StackLimit = .;
+        . += 16K;
+        _sp = .;
+    } > RAM
+}
