diff --git a/bsp/gdr-rv32/SConstruct b/bsp/gdr-rv32/SConstruct
new file mode 100644
--- /dev/null
+++ b/bsp/gdr-rv32/SConstruct
@@ -0,0 +1,29 @@
+import os
+import sys
+import rtconfig
+
+RTT_ROOT = os.path.abspath(os.path.join(os.getcwd(), "../.."))
+sys.path.append(os.path.join(RTT_ROOT, "tools"))
+from building import *
+
+DefaultEnvironment(tools=[])
+env = Environment(
+    tools=["mingw"],
+    AS=rtconfig.AS, ASFLAGS=rtconfig.AFLAGS,
+    CC=rtconfig.CC, CCFLAGS=rtconfig.CFLAGS,
+    CXX=rtconfig.CXX, CXXFLAGS=rtconfig.CXXFLAGS,
+    AR=rtconfig.AR, ARFLAGS="-rc",
+    LINK=rtconfig.LINK, LINKFLAGS=rtconfig.LFLAGS,
+    LIBS=["gcc"],
+)
+env.PrependENVPath("PATH", rtconfig.EXEC_PATH)
+env["ASCOM"] = env["ASPPCOM"]
+Export("RTT_ROOT", "rtconfig")
+objects = PrepareBuilding(env, RTT_ROOT, has_libcpu=True)
+port = os.path.join(RTT_ROOT, "libcpu/risc-v/common")
+objects += DefineGroup("CPU", [os.path.join(port, name) for name in
+                              ("cpuport.c", "context_gcc.S")],
+                       depend=[""], CPPPATH=[port])
+objects += DefineGroup("Trap", [os.path.join(RTT_ROOT, "libcpu/risc-v/e310/interrupt_gcc.S")],
+                       depend=[""], CPPPATH=[port])
+DoBuilding("rtthread." + rtconfig.TARGET_EXT, objects)
